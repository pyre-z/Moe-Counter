# Moe-Counter production env — count.pyre-z.me
# 数据库: Aether 1Panel PostgreSQL (moe_counter 库)
# 说明: 密码占位由部署脚本从 1Panel .env 注入, 本文件不入库

APP_PORT=3000
APP_SITE=https://count.pyre-z.me
DB_TYPE=postgres
DB_URL=postgres://pyre-z:__PG_PASSWORD__@1Panel-postgresql-kph2:5432/moe_counter
# 0 = 每次请求实时落库（杜绝容器重启丢计数）; >0 为惰性批量（可能丢窗口内计数）
DB_INTERVAL=0
LOG_LEVEL=info
